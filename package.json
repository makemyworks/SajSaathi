{
  "name": "saj-saathi-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Saj Saathi customer website, PWA, central API and founder/admin console in one deployment.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "setup": "tsx scripts/setup.ts",
    "check": "npm run typecheck && npm test && npm run lint && npm run build"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "mongodb": "^6.10.0",
    "next": "^15.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@eslint/eslintrc": "^3.2.0",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/web-push": "^3.6.4"
  }
