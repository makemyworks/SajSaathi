
# Saj Saathi Customer + Admin configuration
# Template only. Never put real passwords or secrets here.

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/saj_saathi?retryWrites=true&w=majority

MONGODB_DB=saj_saathi

# Generate two different secrets using Node.js
AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
INTERNAL_API_KEY=REPLACE_WITH_ANOTHER_RANDOM_SECRET

# Local URL defaults
NEXT_PUBLIC_CUSTOMER_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000/admin
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_PARTNER_URL=http://localhost:3001

# Founder account — local setup only
BOOTSTRAP_ADMIN_EMAIL=founder@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD
BOOTSTRAP_ADMIN_NAME=Founder

# Optional contact information
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_GRIEVANCE_OFFICER=

# Optional social media
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=

# Optional integrations
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RESEND_API_KEY=
EMAIL_FROM=

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:founder@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
